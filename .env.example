OPENAI_API_KEY=sk-your-api-key
OPENAI_BASE_URL=

# Example Kimi-compatible setup behind an OpenAI-compatible gateway.
# Prefer the provider-native alias when your gateway exposes it.
CARE_CHAT_MODEL=moonshot/kimi-k2.5
CARE_CHAT_GUARDRAIL_MODEL=moonshot/kimi-k2.5
# Optional: model for the audience router (patient/caregiver/volunteer). Defaults to CARE_CHAT_MODEL.
# CARE_CHAT_ROLE_ROUTER_MODEL=gpt-4.1-mini

# Supported by the Agents SDK: responses or chat_completions
# For Kimi-compatible gateways, prefer chat_completions.
CARE_CHAT_OPENAI_API=chat_completions

# Enable Kimi thinking mode so `--show-reasoning` has content to display.
CARE_CHAT_ENABLE_THINKING=true
CARE_CHAT_DEFAULT_ROLE_HINT=auto
CARE_CHAT_ENABLE_ROLE_ROUTER=true

# none | minimal | low | medium | high | xhigh
CARE_CHAT_REASONING_EFFORT=minimal
CARE_CHAT_GUARDRAIL_REASONING_EFFORT=minimal

CARE_CHAT_TEMPERATURE=0.4
CARE_CHAT_MAX_TOKENS=700
CARE_CHAT_VERBOSITY=low
CARE_CHAT_LANGUAGE=zh-CN
# Agents SDK tracing is enabled by default.
# If you use the official OpenAI API directly, traces can reuse OPENAI_API_KEY.
# If you use a third-party OpenAI-compatible gateway, set CARE_CHAT_TRACING_API_KEY
# to an official OpenAI API key so traces can be exported to https://platform.openai.com/traces
CARE_CHAT_TRACING_DISABLED=false
CARE_CHAT_TRACING_API_KEY=
CARE_CHAT_TRACE_INCLUDE_SENSITIVE_DATA=false
CARE_CHAT_SESSION_DB_PATH=.local/care_chat_sessions.sqlite3
CARE_CHAT_ENABLE_LLM_INPUT_GUARDRAIL=false
CARE_CHAT_ENABLE_LLM_OUTPUT_GUARDRAIL=false
# Optional legacy task-specialist handoffs. Keep false when using the new audience router.
CARE_CHAT_ENABLE_SPECIALIST_HANDOFFS=false
# Optional: limit how many historical items are fetched from the session each turn.
# Leave empty to keep all available context.
CARE_CHAT_SESSION_HISTORY_LIMIT=
